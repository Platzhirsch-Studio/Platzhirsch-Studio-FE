{
  "name": "platzhirsch-studio",
  "version": "0.1.0",
  "private": true,
  "browserslist": {
    "production": [
      "chrome >= 90",
      "firefox >= 90",
      "safari >= 15",
      "edge >= 90",
      "ios >= 15",
      "android >= 90"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "next dev ",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test",
    "test:smoke": "playwright test smoke.spec.js content.spec.js event.spec.js errors.spec.js",
    "test:a11y": "playwright test a11y.spec.js",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "check:claims": "node tools/checks/check-claims.mjs",
    "check:nap": "node tools/checks/check-nap.mjs",
    "check:facts": "node tools/content/check-facts.mjs --strict",
    "check:prod": "node tools/qa/prod-check.mjs",
    "check:perf": "node tools/qa/perf.mjs",
    "pagespeed": "node tools/qa/pagespeed.mjs",
    "pagespeed:ci": "node tools/qa/pagespeed.mjs --ci",
    "check:jsbytes": "node tools/qa/jsbytes.mjs --strict",
    "ci:bundle": "node tools/ci/bundle-budget.mjs",
    "ci:perf-gate": "node tools/ci/perf-gate.mjs",
    "deploy": "bash scripts/deploy.sh deploy",
    "deploy:rollback": "bash scripts/deploy.sh rollback",
    "sofaplaner:3d": "node tools/sofaplaner-3d/convert.mjs",
    "seo:indexnow": "node tools/seo/indexnow.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@google/model-viewer": "^4.4.0",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sparkjsdev/spark": "0.1.10",
    "cookies-next": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "12.43.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.539.0",
    "motion": "^12.43.0",
    "next": "16.4.1",
    "next-intl": "^4.13.0",
    "qrcode": "1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.5",
    "stripe": "22.6.2",
    "three": "^0.183.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@lhci/cli": "0.15.1",
    "@playcanvas/splat-transform": "3.10.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.1",
    "lighthouse": "13.5.0",
    "meshoptimizer": "1.1.1",
    "tailwindcss": "^4.3.1"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
