    { "fieldname": "color_key", "fieldtype": "Data", "label": "Color Key", "reqd": 1, "unique": 1, "in_list_view": 1, "in_global_search": 1, "description": "Lowercase, hyphenated (e.g. \"anthracite\", \"sand\")." },
    { "fieldname": "hex_code", "fieldtype": "Color", "label": "Hex Code", "reqd": 1, "in_list_view": 1, "description": "Color picker widget in the desk UI; stores a #rrggbb string, used for the color swatch dot in the shop filter." },
    { "fieldname": "names_section", "fieldtype": "Section Break", "label": "Name (shown in the filter)" },
    { "fieldname": "name_de", "fieldtype": "Data", "label": "Name (DE)", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "name_en", "fieldtype": "Data", "label": "Name (EN)", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "column_break_names", "fieldtype": "Column Break" },
    { "fieldname": "name_fr", "fieldtype": "Data", "label": "Name (FR)", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "name_it", "fieldtype": "Data", "label": "Name (IT)", "reqd": 1, "in_list_view": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "email": 1, "share": 1 },
