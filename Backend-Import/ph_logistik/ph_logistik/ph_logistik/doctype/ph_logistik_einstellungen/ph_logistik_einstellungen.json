   "options": "guenstigster\nschnellster\nbevorzugt",
   "default": "guenstigster"
  },
  {
   "fieldname": "bevorzugte_carrier",
   "fieldtype": "Small Text",
   "label": "Bevorzugte Carrier (einer je Zeile)",
