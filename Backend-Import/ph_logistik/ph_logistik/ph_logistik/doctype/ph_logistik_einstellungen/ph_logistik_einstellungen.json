   "fieldname": "sb_lms",
   "fieldtype": "Section Break",
   "label": "LetMeShip"
  },
  {
   "fieldname": "letmeship_testmodus",
   "fieldtype": "Check",
   "label": "Testmodus (Mock-Client, keine echten Aufrufe)",
   "default": "1",
   "description": "Solange gesetzt, bucht ph_logistik nur im Mock. Live erst nach Freigabe des Inhabers und LetMeShip-Testzugang (PLAN.md Frage 9)."
  },
  {
   "fieldname": "letmeship_env",
   "fieldtype": "Data",
   "label": "Umgebung laut site_config (ph_letmeship_env)",
   "read_only": 1,
   "description": "Anzeige. Schlüssel liegen NUR in site_config.json: ph_letmeship_api_id, ph_letmeship_api_password, ph_letmeship_env."
  },
  {
   "fieldname": "letmeship_konfiguriert",
