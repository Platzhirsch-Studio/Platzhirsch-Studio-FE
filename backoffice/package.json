    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4.3.1"
  }
}
