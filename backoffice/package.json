{
  "name": "platzhirsch-backoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Eigenes Backoffice von Platzhirsch Home Living (Next.js, Frappe als Datenschicht). Eigener Dienst auf Port 3100.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
