# Backoffice (eigene Next.js-App, Port 3100). Nur Variablennamen – Werte gehören in die Server-Umgebung.
# mock | frappe  (Standard: mock, solange BACKOFFICE_FRAPPE_URL fehlt)
BACKOFFICE_MODE=
# Frappe-Server (gemeinsam mit der Website), z. B. https://backend.platzhirsch.studio – ohne Schlussstrich
BACKOFFICE_FRAPPE_URL=
# API-Token des Service-Benutzers backoffice@platzhirsch.studio ("key:secret"), nur für Systemaufgaben
BACKOFFICE_FRAPPE_TOKEN=
# HMAC-Secret der Sitzungscookies, >= 32 Zeichen, in Produktion Pflicht
BACKOFFICE_SESSION_SECRET=
# Passwort der Demo-Benutzer im Mock (in Entwicklung Rückfall "demo", in Produktion kein Rückfall)
BACKOFFICE_MOCK_PASSWORD=
# Ordner mit den ph_*-Apps für den Mock-Meta-Leser (Standard ../Backend-Import, relativ zu backoffice/)
BACKOFFICE_META_DIR=
# --- Microsoft-Anmeldung (Entra ID / OpenID Connect, Entscheidung Nr. 52) ---
# Verzeichnis-ID (Mandanten-GUID) des Platzhirsch-Tenants – keine Domain
BACKOFFICE_MS_TENANT_ID=
# Anwendungs-ID (Client-ID) der App-Registrierung „Platzhirsch Backoffice“
BACKOFFICE_MS_CLIENT_ID=
# Geheimer Clientschlüssel ODER Zertifikat (BACKOFFICE_MS_CERT_*); Zertifikat hat Vorrang
BACKOFFICE_MS_CLIENT_SECRET=
# Privater Schlüssel des Zertifikats als PEM (\n erlaubt) oder Pfad zur PEM-Datei, plus SHA-1-Fingerabdruck (Hex, wie in Entra)
BACKOFFICE_MS_CERT_KEY=
BACKOFFICE_MS_CERT_KEY_FILE=
BACKOFFICE_MS_CERT_THUMBPRINT=
# Umleitungs-URI, exakt wie in Entra eingetragen, z. B. https://backoffice.platzhirsch.studio/auth/microsoft/callback
BACKOFFICE_MS_REDIRECT_URI=
# Optional: zusätzliche Scopes (z. B. User.Read); Basis immer openid profile email offline_access
BACKOFFICE_MS_SCOPES=
# Optional: 1 = beim Abmelden auch bei Microsoft abmelden
BACKOFFICE_MS_LOGOUT=
# Anmeldearten in Anzeigereihenfolge: microsoft,passwort (Produktion Standard: nur microsoft)
BACKOFFICE_LOGIN_ARTEN=
# Notfall-Passwort-Login ohne "passwort" in BACKOFFICE_LOGIN_ARTEN: E-Mail-Liste, nur Konten mit Admin-Rolle
BACKOFFICE_NOTFALL_ADMINS=
