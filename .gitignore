# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local instructions (not shared in the repo)
CLAUDE.md

# Local-only folders (not part of the site)
/.git-broken-backup/
/data/
/.scratch_imgcheck/

# local server logs
*.log

# Hersteller-Kataloge und -Bilder (lokal, gross, Nutzungsrechte je Hersteller)
/Herstellermaterial/

# Lokale Uploads (Kunden-Fotos/Videos/Pläne) und QA-Screenshots
/.data/
/qa-screenshots/

# Ezarri-Welt: Bilder, Videos, PDFs von ezarri.com (~560 MB, Nutzung laut
# Inhaber-Entscheidung Nr. 7). Nicht im Repo; der Deploy verlinkt die Kopie
# shared/public-ezarri (scripts/deploy.sh, Marktresearch/digital/teamleiter/integration.md).
/public/ezarri/

# Pinterest-Kanal-Vorschau (Inhaber-Entscheidung Nr. 14): erzeugte Pin-Bilder
# (~7 MB, Marktresearch/digital/marketing/pinterest/werkzeug/render-pins.mjs).
# Nur lokal für /de/preview/pinterest – nicht ins Repo, damit nichts davon
# mit scripts/deploy.sh (Release aus Git) ausgeliefert wird. QA Recht P2-7.
/public/preview/pinterest/

# Druck-/PDF-Muster für den Inhaber (Kopie von Platzhirsch-Status/pdf-muster-*), nicht Teil der Website
/Druck/
