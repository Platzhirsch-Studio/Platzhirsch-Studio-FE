# deploy/produktion/website/.env.example – Umgebung der Website (Next.js, Port 3000). NUR NAMEN.
# Auf dem Server als /srv/platzhirsch/website/.env.production (chmod 600). Dieselbe Datei dient
# als Build-Secret (NEXT_PUBLIC_* werden beim Build eingebacken!) und als env_file zur Laufzeit.
# Gesammelt aus process.env.* in src/ (Stand 04.11.2026). Secrets: openssl rand -hex 32.
# Leer gelassene Variablen = Standardverhalten des Codes (meist: Funktion aus bzw. Mock nur in Dev).

# ---------------------------------------------------------------- Grundlagen
# Öffentliche Basis-URL (https://platzhirsch.studio) für absolute Links, Sitemaps, Mails
BASE_URL=
NEXT_PUBLIC_SITE_URL=
# Port (Container: 3000)
PORT=
# Deploy-Kennung für Asset-URLs (Containerfile setzt sie aus dem Git-SHA)
NEXT_DEPLOYMENT_ID=

# ---------------------------------------------------------------- Frappe-Backend
# Basis-URL des Frappe-Backends, ohne Schlussstrich. Neu: https://backend.platzhirsch.studio
# (heute noch https://backoffice.platzhirsch.studio – siehe CHECKLISTE-LIVEGANG.md „Domain-Tausch“)
SERVER=
# API-Token des Benutzers website@platzhirsch.studio (Rolle PH Website Integration)
API_KEY=
API_SECRET=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_URL=
# Cache-Erneuerung durch Frappe (= ph_website_revalidate_secret in site_config)
REVALIDATE_SECRET=

# ---------------------------------------------------------------- Kundenportal
# mock | frappe
PORTAL_ADAPTER=
PORTAL_BASE_URL=
# HMAC der Portal-Sitzungen (>= 32 Zeichen)
PORTAL_SESSION_SECRET=
PORTAL_MAIL_PROVIDER=
PORTAL_MAIL_API_KEY=
PORTAL_MAIL_FROM=
PORTAL_MAIL_FRAPPE_METHOD=
PORTAL_MAIL_WEBHOOK_URL=
PORTAL_MAIL_WEBHOOK_SECRET=
TAGEBUCH_ADAPTER=
TAGEBUCH_DIR=
TAGEBUCH_PREVIEW=
TAGEBUCH_TEAM_KONTEN=
RAUMZWILLING_DIR=
RAUM_TEAM_TOKEN=

# ---------------------------------------------------------------- Terminbuchung
