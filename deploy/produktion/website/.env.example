BOOKING_PROVIDER=
BOOKING_MOCK=
BOOKING_DATA_DIR=
BOOKING_LINK_SECRET=
BOOKING_PUBLIC_BASE_URL=
BOOKING_MAIL_API_KEY=
BOOKING_MAIL_FROM=
FRAPPE_BOOKING_URL=
FRAPPE_BOOKING_KEY=
FRAPPE_BOOKING_SECRET=
FRAPPE_BOOKING_METHOD_BASE=

# ---------------------------------------------------------------- Zahlungen / Shop (Stripe)
STRIPE_SECRET_KEY=
# Signatur-Secret des Stripe-Webhooks https://platzhirsch.studio/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=
STRIPE_INVOICE_CREATION=
PAYMENTS_BASE_URL=
PAYMENTS_DATA_DIR=
# HMAC für Anzahlungs-Links (= ph_payments_link_secret in Frappe)
