# /etc/default/caddy – Umgebung für die Caddyfile (systemd-Unit von Caddy: EnvironmentFile=/etc/default/caddy).
# NUR NAMEN; Werte auf dem jeweiligen Host.

# Kontakt für Let's Encrypt (Ablaufwarnungen), z. B. it@…
ACME_EMAIL=
# Frappe-Host: Adressen von Website- und Backoffice-Host (CIDR, Leerzeichen-getrennt)
WEBSITE_IPS=
BACKOFFICE_IPS=
# Frappe-Host und optional Backoffice-Host: Büro/VPN/Admin (CIDR, Leerzeichen-getrennt)
ADMIN_IPS=
# Backoffice-Host: erlaubte Quellnetze (leer = offen für alle)
BACKOFFICE_ALLOW_IPS=
# Backoffice-Host, nur Vorschauphase: bcrypt-Hash aus "caddy hash-password"
BACKOFFICE_BASIC_AUTH_HASH=
