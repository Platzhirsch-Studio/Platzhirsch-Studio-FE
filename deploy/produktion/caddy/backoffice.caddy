# Backoffice: backoffice.platzhirsch.studio → Next.js :3100.
# Zugriff optional nur aus VPN/Büro/Admin-IPs: BACKOFFICE_ALLOW_IPS (Leerzeichen-getrennte CIDRs).
# Standard 0.0.0.0/0 ::/0 = offen (Login mit 2FA schützt). Vorschauphase zusätzlich Basic-Auth
# (PLAN-NEXT-BACKOFFICE.md §2): Block unten einkommentieren, Hash mit "caddy hash-password".

backoffice.platzhirsch.studio {
	import sicherheit
	import zugriffslog backoffice
	header X-Robots-Tag "noindex, nofollow, noarchive"

	@gesperrt not remote_ip {$BACKOFFICE_ALLOW_IPS:0.0.0.0/0 ::/0}
	respond @gesperrt "Kein Zugriff" 403

	# basic_auth {
	# 	vorschau {$BACKOFFICE_BASIC_AUTH_HASH}
	# }

	request_body {
		max_size 50MB
	}
	reverse_proxy 127.0.0.1:3100 {
		import proxy_header
		transport http {
			read_timeout 120s
		}
	}
}
