# deploy/produktion/frappe/.env – Compose-Variablen des Frappe-Hosts. NUR NAMEN hier; Werte auf dem Server
# in deploy/produktion/frappe/.env (chmod 600, gitignored). Erzeugen: openssl rand -hex 32

# Compose-Projektname (Standard ph-frappe)
COMPOSE_PROJECT_NAME=
# Frappe-Zweig, version-15
FRAPPE_BRANCH=
# Image-Name/Tag, falls aus einer Registry gezogen statt lokal gebaut (Standard platzhirsch/frappe-ph:produktion)
FRAPPE_IMAGE=
# Site-Name = öffentliche Domain des Backends (backend.platzhirsch.studio)
SITE_NAME=
# Root-Passwort MariaDB (openssl rand -hex 32)
DB_ROOT_PASSWORD=
# InnoDB-Buffer-Pool, etwa 25–40 % des RAM (z. B. 2G bei 8 GB)
DB_BUFFER_POOL=
# Passwort des Frappe-Benutzers Administrator (openssl rand -hex 24; danach 2FA für alle Admins)
ADMIN_PASSWORD=
# Port, auf dem der Frappe-Nginx am Host lauscht (nur 127.0.0.1; Standard 8080)
FRAPPE_HTTP_PORT=
# Netz des vorgeschalteten Reverse-Proxys für X-Forwarded-For (Standard Docker-Bereich 172.16.0.0/12)
UPSTREAM_REAL_IP_ADDRESS=
# 1 = ph_kundenkarte[wallet] (cryptography für Wallet-Pässe)
PH_WALLET=

# --- Backup (backup.sh) ---
# Ordner auf dem Host für Backup-Kopien (Standard /srv/platzhirsch/backups/frappe)
BACKUP_DIR=
# Wie viele Tage lokale Backups behalten werden (Standard 14)
BACKUP_KEEP_DAYS=
# Offsite-Ziel für rclone (z. B. "storagebox:platzhirsch/frappe"), leer = kein Offsite-Kopieren
BACKUP_RCLONE_REMOTE=
# Optional: URL, die nach erfolgreichem Backup aufgerufen wird (Heartbeat für Uptime-Monitor)
BACKUP_HEARTBEAT_URL=

# --- site_config.json (NICHT hier, sondern per "bench --site <site> set-config <name> <wert>") ---
# ph_stripe_secret_key, ph_stripe_webhook_secret, ph_stripe_livemode, ph_stripe_terminal_location,
# ph_resend_api_key, ph_mail_from, ph_letmeship_api_id, ph_letmeship_api_password, ph_letmeship_env,
# ph_website_revalidate_url, ph_website_revalidate_secret, ph_kassa_aes_key_<kassen_id>,
# ph_atrust_user, ph_atrust_password, ph_atrust_env, ph_meet_api_token, ph_payments_link_secret
# (Register: Backend-Import/README.md §3). ph_kassa_test_see_key_<see> nur auf Staging.
