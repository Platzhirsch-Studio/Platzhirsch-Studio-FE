# deploy/produktion/backoffice/.env.example – Umgebung des Backoffice (Next.js, Port 3100). NUR NAMEN.
# Auf dem Server als /srv/platzhirsch/backoffice/.env.production (chmod 600).
# Quelle: backoffice/src/lib/backoffice/config.js, backoffice/.env.example.

# frappe in Produktion (mock nur für Vorführungen; ohne BACKOFFICE_FRAPPE_URL automatisch mock)
BACKOFFICE_MODE=
# Frappe-Backend ohne Schlussstrich: https://backend.platzhirsch.studio (bzw. internes Netz, z. B. http://10.0.0.3:8080 mit Host-Header – siehe README)
BACKOFFICE_FRAPPE_URL=
# Token des Service-Benutzers backoffice@platzhirsch.studio im Format key:secret (einrichten.sh --token)
BACKOFFICE_FRAPPE_TOKEN=
# HMAC der Sitzungscookies, >= 32 Zeichen: openssl rand -hex 32. Fehlt es, ist die Anmeldung gesperrt (fail-closed)
BACKOFFICE_SESSION_SECRET=
# Nur im Mock-Modus: Passwort der Demo-Benutzer (Produktion: leer lassen)
BACKOFFICE_MOCK_PASSWORD=
# Nur Mock/Dev: Ordner mit den ph_*-Apps (im Frappe-Modus nicht nötig, im Image nicht enthalten)
BACKOFFICE_META_DIR=
# Port (Container: 3100)
PORT=
