# deploy/staging/.env – nur Namen. setup.sh legt .env beim ersten Lauf an und füllt die Passwörter
# mit "openssl rand -hex 24". Die Datei .env ist in deploy/.gitignore und gehört nie ins Repo.

# Compose-Projektname (Container heißen ph-staging-…)
COMPOSE_PROJECT_NAME=
# Frappe-Zweig (version-15, siehe Backend-Import/CONVENTIONS.md)
FRAPPE_BRANCH=
# Name der Site (Standard staging.platzhirsch.local)
SITE_NAME=
# Root-Passwort der MariaDB im Container (nur Staging)
DB_ROOT_PASSWORD=
# Passwort des Frappe-Benutzers Administrator auf der Staging-Site
ADMIN_PASSWORD=
# Adresse/Port, an dem Nginx auf dem Host lauscht (Standard 127.0.0.1:8080 – nur per SSH-Tunnel erreichbar)
STAGING_BIND=
STAGING_PORT=
# 1 = optionale Abhängigkeit ph_kundenkarte[wallet] (cryptography) installieren
PH_WALLET=
